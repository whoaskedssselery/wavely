{
  "name": "wavely",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "electron:dev": "node electron/dev.js",
    "electron:build": "tsc -b && vite build && electron-builder"
  },
  "dependencies": {
    "@a1rth/css-normalize": "1.2.4",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "5.4.0",
    "@supabase/supabase-js": "2.108.2",
    "@tanstack/react-query": "5.101.0",
    "framer-motion": "12.41.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.80.0",
    "react-router-dom": "7.18.0",
    "sass": "1.101.0",
    "swiper": "14.0.6",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@tanstack/react-query-devtools": "5.101.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "typescript": "~6.0.2",
    "vite": "8.0.12"
  },
  "build": {
    "appId": "com.wavely.app",
    "productName": "wavely",
    "files": ["dist/**", "electron/**"],
    "directories": {
      "output": "release"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"],
      "category": "AudioVideo"
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png"
    }
  }
}
